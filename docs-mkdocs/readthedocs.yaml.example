# Copy to the repo root as `.readthedocs.yaml` when switching Read the Docs over to Zensical.
# Not tried on Read the Docs yet: build it from a branch preview first (`build.commands` replaces its own build step).
# The 99 forced `/en/<version>/*` -> `/en/latest/:splat` redirect rules need no change: they only rewrite the prefix.
version: 2

build:
  os: ubuntu-24.04
  tools:
    python: "3.12"
  commands:
    - pip install -r docs-mkdocs/requirements.txt .
    - docs-mkdocs/build_zensical.sh
    - mkdir -p $READTHEDOCS_OUTPUT/html
    - cp -R site/. $READTHEDOCS_OUTPUT/html/
