# Copy this file to `.env` and fill in your values.

# From your Meta App > WhatsApp > API Setup
PYWA_PHONE_ID=
PYWA_TOKEN=

# From your Meta App > App Settings > Basic (the app secret is used to validate incoming updates)
PYWA_APP_ID=
PYWA_APP_SECRET=

# Your WhatsApp Business Account ID
PYWA_WABA_ID=

# --- Bot specific ---

# URL shown on the "Track your order" button after checkout
TRACK_ORDER_URL=https://example.com/track-order
