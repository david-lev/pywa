# Copy this file to `.env` and fill in your values.

# From your Meta App > WhatsApp > API Setup
PYWA_PHONE_ID=
PYWA_TOKEN=

# From your Meta App > App Settings > Basic (the app secret is used to validate incoming updates)
PYWA_APP_ID=
PYWA_APP_SECRET=

# Your WhatsApp Business Account ID
PYWA_WABA_ID=

# --- Bot specific ---

# Generated with:
#   openssl genrsa -des3 -out private.pem 2048
#   openssl rsa -in private.pem -outform PEM -pubout -out public.pem
BUSINESS_PUBLIC_KEY_PATH=./public.pem
BUSINESS_PRIVATE_KEY_PASSWORD=
# The private key *contents* (PEM text, in quotes), not a path:
PYWA_FLOW_PRIVATE_KEY="-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----"

# Filled in after running `python3 setup_flow.py`
LOAN_FLOW_ID=

# Public URL of your bot (only used by setup_flow.py to set the flow endpoint)
CALLBACK_URL=
