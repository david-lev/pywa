# Copy this file to `.env` and fill in your values.

WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=xyzxyz

# Flows require a *stable* callback URL (the same one you register the flow endpoint against in
# setup_flow.py), so a static ngrok domain or a real deployed URL is strongly recommended here.
CALLBACK_URL=
NGROK_AUTH_TOKEN=

# --- Bot specific ---

WHATSAPP_BUSINESS_ACCOUNT_ID=

# Generated with:
#   openssl genrsa -des3 -out private.pem 2048
#   openssl rsa -in private.pem -outform PEM -pubout -out public.pem
BUSINESS_PUBLIC_KEY_PATH=./public.pem
BUSINESS_PRIVATE_KEY_PATH=./private.pem
BUSINESS_PRIVATE_KEY_PASSWORD=

# Filled in after running `python3 setup_flow.py`
LOAN_FLOW_ID=
