# Copy this file to `.env` and fill in your values.

# From your Meta App > WhatsApp > API Setup
PYWA_PHONE_ID=
PYWA_TOKEN=

# From your Meta App > App Settings > Basic (the app secret is used to validate incoming updates)
PYWA_APP_ID=
PYWA_APP_SECRET=

# Your WhatsApp Business Account ID
PYWA_WABA_ID=

# --- Bot specific ---

# Comma separated BSUIDs to silently ignore
BLOCKED_BSUIDS=

# WhatsApp number (with country code, no +) of a human agent to forward escalations to
SUPPORT_AGENT_NUMBER=
