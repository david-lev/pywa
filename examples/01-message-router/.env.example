# Copy this file to `.env` and fill in your values.

# From your Meta App > WhatsApp > API Setup
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# From your Meta App > App Settings > Basic
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=

# Any string you choose — must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=xyzxyz

# Your public HTTPS URL (e.g. https://your-domain.com). Leave empty during local
# development to auto-create a temporary tunnel with ngrok (requires NGROK_AUTH_TOKEN).
CALLBACK_URL=

# https://dashboard.ngrok.com/get-started/your-authtoken (only needed if CALLBACK_URL is empty)
NGROK_AUTH_TOKEN=

# --- Bot specific ---

# Comma separated BSUIDs to silently ignore
BLOCKED_BSUIDS=

# WhatsApp number (with country code, no +) of a human agent to forward escalations to
SUPPORT_AGENT_NUMBER=
